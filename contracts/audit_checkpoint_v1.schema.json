{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integin.local/contracts/audit-checkpoint/v1",
  "title": "INTEGIN Audit Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_version", "tenant_id", "environment", "sequence_start", "sequence_end", "previous_root_sha256", "entries", "root_sha256"],
  "properties": {
    "checkpoint_version": { "const": "audit-checkpoint/v1" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "sequence_start": { "type": "integer", "minimum": 1 },
    "sequence_end": { "type": "integer", "minimum": 1 },
    "previous_root_sha256": { "oneOf": [{ "const": "GENESIS" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "record_id", "tenant_id", "environment", "actor_type", "actor_id", "action", "resource_type", "resource_id", "outcome", "correlation_id", "context_sha256", "created_at"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "actor_type": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "resource_type": { "type": "string", "minLength": 1 },
        "resource_id": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "context_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
