# Multi-stage Dockerfile for INTEGIN Sovereign Monolith Server
FROM golang:1.24-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
ENV GOTOOLCHAIN=auto
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /bin/integin-server ./cmd/integin-server

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -g 10001 -S integin \
    && adduser -u 10001 -S -G integin -h /app integin

WORKDIR /app
COPY --from=builder /bin/integin-server /app/integin-server

USER 10001:10001
EXPOSE 8080

ENTRYPOINT ["/app/integin-server"]
