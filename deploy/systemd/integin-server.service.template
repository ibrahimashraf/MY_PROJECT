[Unit]
Description=INTEGIN Go acceptance server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=integin
Group=integin
WorkingDirectory=/opt/integin
EnvironmentFile=/etc/integin/acceptance.env
ExecStart=/opt/integin/bin/integin-server
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/integin /var/log/integin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
