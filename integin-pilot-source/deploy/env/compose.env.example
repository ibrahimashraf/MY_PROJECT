# Copy outside source control, then replace only paths and non-secret labels.
# Secret FILE paths must point to root-owned/private files; never put values here.
INTEGIN_STACK_NAME=integin-pilot
INTEGIN_POSTGRES_DB=integin
INTEGIN_POSTGRES_USER=integin
INTEGIN_POSTGRES_BIND_ADDRESS=127.0.0.1
INTEGIN_POSTGRES_PORT=5432
INTEGIN_RUSTFS_BIND_ADDRESS=127.0.0.1
INTEGIN_RUSTFS_API_PORT=9000
INTEGIN_RUSTFS_CONSOLE_PORT=9001
INTEGIN_POSTGRES_PASSWORD_FILE=/etc/integin/secrets/postgres_password
INTEGIN_RUSTFS_ACCESS_KEY_FILE=/etc/integin/secrets/rustfs_access_key
INTEGIN_RUSTFS_SECRET_KEY_FILE=/etc/integin/secrets/rustfs_secret_key
