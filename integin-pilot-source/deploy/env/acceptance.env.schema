# This is a variable-name schema, not a runnable environment file.
# Store values only in a private, root-owned environment file outside source control.

# Required application and persistence contract
INTEGIN_HTTP_ADDR=<loopback_or_private_listener_address>
INTEGIN_DB_URL=<private_postgresql_connection_url>
INTEGIN_RUSTFS_ENDPOINT=<private_rustfs_s3_endpoint>
INTEGIN_RUSTFS_REGION=<deployment_region_label>
INTEGIN_RUSTFS_BUCKET=<approved_evidence_bucket>
INTEGIN_RUSTFS_ACCESS_KEY=<private_value>
INTEGIN_RUSTFS_SECRET_KEY=<private_value>
INTEGIN_SYNC_SECRET=<private_value>

# Protective defaults for ordinary acceptance and source-only work
INTEGIN_OIDC_ENABLED=false
INTEGIN_LOCAL_PROVISIONING_ENABLED=false

# Candidate-only variables: leave unset in persistent acceptance environments.
# INTEGIN_PILOT_RUNTIME
# INTEGIN_PILOT_PACKAGE_POLICY_PREPARATION
# INTEGIN_PILOT_PACKAGE_POLICY_REGISTRATION
# INTEGIN_PILOT_PACKAGE_ENFORCEMENT
# INTEGIN_PILOT_MANIFEST_RETRIEVAL
# INTEGIN_PILOT_MANIFEST_PRIVATE_KEY_BASE64URL
# INTEGIN_PILOT_MANIFEST_KEY_ID
