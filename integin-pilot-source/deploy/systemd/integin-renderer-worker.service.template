[Unit]
Description=INTEGIN Isolated Non-Authoritative PDF Rendering Worker
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=integin
Group=integin
# Enforce zero egress via container network_mode: none
ExecStart=/usr/bin/docker run --rm --net=none --memory=512m --cpus=1.0 --read-only --tmpfs /tmp:size=64M,uid=10001,gid=10001,mode=1777 integin/renderer-worker:69.0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
